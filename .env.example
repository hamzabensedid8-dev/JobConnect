# ---------------------------------------------------------------------------
# Cloudflare
# ---------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=          # token with "Workers Scripts:Edit"
CLOUDFLARE_ACCOUNT_ID=9730b560e0620856580eec9f1d40c658
WORKER_NAME=jc
PUBLIC_URL=https://jc.jobconnectdz.workers.dev   # used for Stripe redirect URLs
CORS_ORIGIN=*
ADMIN_CLIENT_KEY=              # 24+ random chars; the APK must carry the same value

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=https://nwezezjssrigrjqfoqov.supabase.co
SUPABASE_SERVICE_KEY=          # service_role key — never commit
JWT_SECRET=                    # 32+ random chars (openssl rand -base64 48)

# ---------------------------------------------------------------------------
# Stripe — real card payments (Visa / Mastercard)
# Leave empty and the API answers 503 instead of pretending to charge.
# ---------------------------------------------------------------------------
# The receiving account can also be changed at runtime from the admin console
# (APK → Money tab). The keys pasted there are stored encrypted in Postgres and
# take precedence over these variables.
STRIPE_SECRET_KEY=             # sk_live_... / sk_test_...
STRIPE_PUBLISHABLE_KEY=        # pk_live_... / pk_test_... (inline card form)
STRIPE_WEBHOOK_SECRET=         # whsec_... from the webhook endpoint

# Passphrase used by pgcrypto to encrypt the credentials stored in
# integration_credentials. 32+ random chars, never stored in the database.
# Without it the admin console cannot save a receiving account.
CREDENTIAL_KEY=                # openssl rand -base64 48

# ---------------------------------------------------------------------------
# Resend — real e-mail delivery (receipts, decisions)
# Leave empty and every e-mail is logged with status "skipped".
# ---------------------------------------------------------------------------
RESEND_API_KEY=                # re_...
MAIL_FROM=                     # JobConnect <no-reply@yourdomain.com>
